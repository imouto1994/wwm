{
  "name": "wwm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:boss": "pnpm --filter wwm-boss-guide dev",
    "dev:reforge": "pnpm --filter wwm-reforge dev",
    "build:boss": "pnpm --filter wwm-boss-guide build:gh-pages",
    "build:reforge": "pnpm --filter wwm-reforge build",
    "build": "pnpm -r build",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
